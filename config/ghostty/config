# configure ghostty to show git branch/worktree in tab labels
# shell-integration-features = no-title
# shell-integration = zsh  

# integration tabs into title bar
macos-titlebar-style = tabs
bell-features = title
macos-icon = retro

# how much to keep in the terminal buffer
scrollback-limit = 100000000

font-family = "JetBrains Mono"
# font-family = "Fira Code"
font-size = 13
font-feature = -liga

# windows
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-padding-color = background
window-height = 56
window-width = 238
window-vsync = true
window-inherit-font-size = true
window-subtitle = working-directory
window-save-state = always
confirm-close-surface = false

# theme = Dracula
palette = 0=#22212C
palette = 1=#FF9580
palette = 2=#8AFF80
palette = 3=#FFFF80
palette = 4=#9580FF
palette = 5=#FF80BF
palette = 6=#80FFEA
palette = 7=#F8F8F2
palette = 8=#504C67
palette = 9=#FFAA99
palette = 10=#A2FF99
palette = 11=#FFFF99
palette = 12=#AA99FF
palette = 13=#FF99CC
palette = 14=#99FFEE
palette = 15=#FFFFFF
background = #282A36
foreground = #F8F8F2
cursor-color = #7970A9
cursor-text = #7970A9
selection-background = #B87EFF
split-divider-color = #BD93F9
selection-foreground = #22212C

# cursor settings
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true
cursor-color = #FF80BF
cursor-text = #7970A9

# keyboard bindings
# clear the window like ctrl + l
keybind = cmd+k=text:\x0c

# # Unbind Vim/Emacs Movement Keys
keybind = super+arrow_left=unbind
keybind = super+arrow_right=unbind
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# Disable Jump to Prompt
# keybind = super+arrow_down=unbind
# keybind = super+arrow_up=unbind
# keybind = super+shift+arrow_down=unbind
# keybind = super+shift+arrow_up=unbind

# Unbind close surface
# keybind = super+w=unbind

# Remove Tab Keybinds
keybind = super+t=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+alt+w=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind

# Remove Split Keybinds
keybind = super+d=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+ctrl+==unbind
keybind = super+alt+arrow_up=unbind
keybind = super+]=unbind
keybind = super+shift+enter=unbind
keybind = super+[=unbind
keybind = super+shift+d=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_left=unbind

